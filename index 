<script>
  /* =====================================================
     ⚙️ الإعدادات — عدّل من هنا فقط
     ===================================================== */
  const WHATSAPP_NUMBER = "967776485967"; // ← رقم الواتساب
  const INSTAGRAM_USER  = "6.fcr";
  /* ===================================================== */

  const waLink = (text) =>
    `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;

  const defaultMsg = "مرحباً محمد 👋\nأرغب بالاستفسار عن خدماتك.";
  document.querySelectorAll(".wa-link").forEach(a => {
    a.href = waLink(defaultMsg);
  });
  const waHero = document.getElementById("waHero");
  if (waHero) waHero.href = waLink(defaultMsg);

  document.getElementById("year").textContent = new Date().getFullYear();

  const burger = document.getElementById("burger");
  const navList = document.getElementById("navList");
  burger.addEventListener("click", () => navList.classList.toggle("open"));
  navList.querySelectorAll("a").forEach(a =>
    a.addEventListener("click", () => navList.classList.remove("open"))
  );

  const phrases = [
    "خدمات إلكترونية احترافية",
    "تعديل صوتي نقي وواضح",
    "تصميم جرافيك إبداعي",
    "حلول رقمية بجودة عالية"
  ];
  const typedEl = document.getElementById("typed");
  let pi = 0, ci = 0, deleting = false;
  function typeLoop() {
    const word = phrases[pi];
    typedEl.textContent = deleting
      ? word.substring(0, ci--)
      : word.substring(0, ci++);

    let delay = deleting ? 45 : 90;

    if (!deleting && ci === word.length + 1) {
      deleting = true;
      delay = 1600;
    } else if (deleting && ci === 0) {
      deleting = false;
      pi = (pi + 1) % phrases.length;
      delay = 350;
    }
    setTimeout(typeLoop, delay);
  }
  typeLoop();

  const counters = document.querySelectorAll(".counter");
  const counterObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = +el.dataset.target;
      let cur = 0;
      const step = Math.max(1, Math.ceil(target / 60));
      const timer = setInterval(() => {
        cur += step;
        if (cur >= target) { cur = target; clearInterval(timer); }
        el.textContent = cur + (target === 100 ? "" : "+");
        if (target === 100) el.textContent = cur;
      }, 24);
      counterObs.unobserve(el);
    });
  }, { threshold: 0.5 });
  counters.forEach(c => counterObs.observe(c));

  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add("show"), i * 70);
        revealObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll(".reveal").forEach(el => revealObs.observe(el));

  const form = document.getElementById("orderForm");
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = document.getElementById("name").value.trim();
    const service = document.getElementById("service").value;
    const details = document.getElementById("details").value.trim();

    const msg =
      `مرحباً محمد طه 👋\n` +
      `الاسم: ${name}\n` +
      `الخدمة المطلوبة: ${service}\n` +
      `التفاصيل: ${details}`;

    window.open(waLink(msg), "_blank");
  });

  const toTop = document.getElementById("toTop");
  window.addEventListener("scroll", () => {
    toTop.classList.toggle("show", window.scrollY > 500);
  });
  toTop.addEventListener("click", () =>
    window.scrollTo({ top: 0, behavior: "smooth" })
  );
</script>
