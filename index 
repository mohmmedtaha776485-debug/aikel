<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>محمد طه | خدمات إلكترونية • تعديل صوتي • تصميم جرافيك</title>
<meta name="description" content="محمد طه — خدمات إلكترونية، تعديل صوتي احترافي، وتصميم جرافيك إبداعي. تواصل واتساب: 776485967" />
<meta name="theme-color" content="#04050a" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Orbitron:wght@700;900&display=swap" rel="stylesheet" />
<style>
  /* ============ الأساسيات ============ */
  *{margin:0;padding:0;box-sizing:border-box}
  :root{
    --cyan:#00eaff;
    --magenta:#ff1fd6;
    --purple:#7b2cff;
    --dark:#04050a;
    --dark2:#0a0d18;
    --card:rgba(12,17,32,.72);
    --txt:#d7e3f4;
    --muted:#8fa3bf;
    --line:rgba(0,234,255,.22);
  }
  html{scroll-behavior:smooth}
  body{
    background:var(--dark);
    color:var(--txt);
    font-family:'Cairo',system-ui,sans-serif;
    overflow-x:hidden;
    line-height:1.8;
  }
  a{text-decoration:none;color:inherit}
  img{max-width:100%;display:block}
  ::selection{background:var(--magenta);color:#fff}

  /* ============ الخلفية السبرانية ============ */
  .bg-layer{
    position:fixed;inset:0;z-index:-4;
    background:
      radial-gradient(circle at 18% 8%, rgba(123,44,255,.28), transparent 45%),
      radial-gradient(circle at 82% 18%, rgba(255,31,214,.20), transparent 45%),
      radial-gradient(circle at 50% 105%, rgba(0,234,255,.22), transparent 55%),
      var(--dark);
  }
  .grid-floor{
    position:fixed;left:-10%;right:-10%;bottom:0;height:48vh;z-index:-3;
    background-image:
      linear-gradient(rgba(0,234,255,.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,234,255,.18) 1px, transparent 1px);
    background-size:60px 60px;
    transform:perspective(420px) rotateX(63deg);
    transform-origin:bottom center;
    -webkit-mask-image:linear-gradient(to top, rgba(0,0,0,.95), transparent);
    mask-image:linear-gradient(to top, rgba(0,0,0,.95), transparent);
    animation:gridmove 5s linear infinite;
  }
  @keyframes gridmove{to{background-position:0 60px, 0 0}}
  .scanlines{
    position:fixed;inset:0;z-index:9998;pointer-events:none;
    background:repeating-linear-gradient(to bottom, rgba(0,0,0,.20) 0 1px, transparent 1px 3px);
    opacity:.45;
  }
  .orb{position:fixed;border-radius:50%;filter:blur(70px);z-index:-2;opacity:.55;pointer-events:none}
  .orb.a{width:340px;height:340px;background:var(--purple);top:-80px;right:-60px;animation:float 12s ease-in-out infinite}
  .orb.b{width:300px;height:300px;background:var(--cyan);bottom:-90px;left:-70px;animation:float 15s ease-in-out infinite reverse}
  @keyframes float{50%{transform:translateY(50px) translateX(-30px)}}

  /* ============ الهيدر ============ */
  header{
    position:fixed;top:0;left:0;right:0;z-index:1000;
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 5vw;
    background:linear-gradient(to bottom, rgba(4,5,10,.95), rgba(4,5,10,.45));
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line);
  }
  .logo{display:flex;align-items:center;gap:10px;font-weight:900;font-size:1.05rem}
  .logo .mark{
    width:38px;height:38px;display:grid;place-items:center;
    border:2px solid var(--cyan);border-radius:10px;
    color:var(--cyan);font-family:'Orbitron',sans-serif;font-size:.8rem;
    box-shadow:0 0 14px rgba(0,234,255,.55), inset 0 0 14px rgba(0,234,255,.25);
    text-shadow:0 0 8px var(--cyan);
  }
  .logo span.name{background:linear-gradient(90deg,var(--cyan),var(--magenta));-webkit-background-clip:text;background-clip:text;color:transparent}
  nav ul{display:flex;gap:26px;list-style:none;align-items:center}
  nav a{
    font-size:.92rem;font-weight:600;color:var(--muted);
    position:relative;padding:4px 0;transition:.3s;
  }
  nav a::after{
    content:'';position:absolute;bottom:-2px;right:0;width:0;height:2px;
    background:linear-gradient(90deg,var(--cyan),var(--magenta));transition:.35s;
  }
  nav a:hover{color:#fff;text-shadow:0 0 10px rgba(0,234,255,.8)}
  nav a:hover::after{width:100%}
  .burger{
    display:none;background:none;border:1px solid var(--line);border-radius:9px;
    width:44px;height:40px;cursor:pointer;color:var(--cyan);font-size:1.2rem;
  }

  /* ============ الأزرار ============ */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    padding:13px 30px;border-radius:12px;font-weight:700;font-size:.95rem;
    cursor:pointer;border:none;transition:.35s;position:relative;overflow:hidden;
    font-family:'Cairo',sans-serif;
  }
  .btn-primary{
    background:linear-gradient(135deg,var(--cyan),var(--purple));
    color:#04050a;
    box-shadow:0 0 22px rgba(0,234,255,.5);
  }
  .btn-primary:hover{transform:translateY(-3px);box-shadow:0 0 34px rgba(0,234,255,.85)}
  .btn-ghost{
    background:rgba(0,234,255,.06);color:var(--cyan);
    border:1px solid var(--cyan);
    box-shadow:inset 0 0 18px rgba(0,234,255,.15);
  }
  .btn-ghost:hover{background:rgba(0,234,255,.16);box-shadow:0 0 24px rgba(0,234,255,.6);transform:translateY(-3px)}
  .btn-wa{
    background:linear-gradient(135deg,#25D366,#128C7E);color:#fff;
    box-shadow:0 0 22px rgba(37,211,102,.45);
  }
  .btn-wa:hover{transform:translateY(-3px);box-shadow:0 0 34px rgba(37,211,102,.8)}
  .btn-ig{
    background:linear-gradient(135deg,#feda75,#d62976,#962fbf,#4f5bd5);color:#fff;
    box-shadow:0 0 22px rgba(214,41,118,.45);
  }
  .btn-ig:hover{transform:translateY(-3px);box-shadow:0 0 34px rgba(214,41,118,.8)}

  /* ============ الهيرو ============ */
  .hero{
    min-height:100vh;display:flex;flex-direction:column;
    align-items:center;justify-content:center;text-align:center;
    padding:130px 5vw 70px;position:relative;
  }
  .hero-badge{
    display:inline-flex;align-items:center;gap:9px;
    font-size:.78rem;font-weight:700;letter-spacing:1px;
    padding:7px 18px;border-radius:50px;margin-bottom:26px;
    border:1px solid rgba(0,234,255,.4);
    background:rgba(0,234,255,.07);color:var(--cyan);
    box-shadow:0 0 20px rgba(0,234,255,.2) inset;
  }
  .dot{
    width:8px;height:8px;border-radius:50%;background:#22ff88;
    box-shadow:0 0 10px #22ff88;animation:pulse 1.4s infinite;
  }
  @keyframes pulse{50%{opacity:.25;transform:scale(.7)}}

  /* ============ صورة البروفايل ============ */
  .profile-container {
    margin-bottom: 25px;
    position: relative;
    display: inline-block;
    animation: floatProfile 4s ease-in-out infinite;
  }
  @keyframes floatProfile {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .profile-pic {
    width: 190px;
    height: 190px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--cyan);
    box-shadow: 0 0 25px var(--cyan), 0 0 50px var(--magenta);
    transition: 0.5s ease;
    position: relative;
    z-index: 2;
  }
  .profile-pic:hover {
    transform: scale(1.05) rotate(3deg);
    box-shadow: 0 0 35px var(--magenta), 0 0 60px var(--cyan);
  }
  .profile-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2px dashed var(--magenta);
    animation: spinRing 10s linear infinite;
    z-index: 1;
  }
  @keyframes spinRing {
    100% { transform: rotate(360deg); }
  }

  .glitch{
    font-size:clamp(2.7rem,10vw,6.5rem);
    font-weight:900;line-height:1.15;letter-spacing:2px;
    position:relative;color:#fff;
    text-shadow:0 0 18px rgba(0,234,255,.65), 0 0 45px rgba(123,44,255,.55);
  }
  .glitch::before,.glitch::after{
    content:attr(data-text);position:absolute;inset:0;
    background:var(--dark);overflow:hidden;
  }
  .glitch::before{color:var(--magenta);clip-path:polygon(0 0,100% 0,100% 45%,0 45%);animation:gl1 3.2s infinite linear alternate-reverse;left:2px}
  .glitch::after{color:var(--cyan);clip-path:polygon(0 55%,100% 55%,100% 100%,0 100%);animation:gl2 2.6s infinite linear alternate-reverse;left:-2px}
  @keyframes gl1{0%,88%{transform:translate(0);opacity:0}90%{transform:translate(-4px,-2px);opacity:.85}100%{transform:translate(3px,2px);opacity:0}}
  @keyframes gl2{0%,85%{transform:translate(0);opacity:0}88%{transform:translate(4px,2px);opacity:.85}100%{transform:translate(-3px,-2px);opacity:0}}

  .hero-sub{
    margin-top:16px;font-size:clamp(.95rem,2.4vw,1.3rem);
    font-weight:700;color:#fff;letter-spacing:1px;
  }
  .hero-sub span{color:var(--magenta);text-shadow:0 0 12px var(--magenta)}
  .typed-wrap{margin-top:14px;font-size:1.05rem;color:var(--muted);min-height:34px}
  .typed{color:var(--cyan);font-weight:700;text-shadow:0 0 14px rgba(0,234,255,.8)}
  .cursor{color:var(--magenta);animation:blink .8s steps(1) infinite}
  @keyframes blink{50%{opacity:0}}

  .hero-btns{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin-top:38px}

  /* ============ الإحصائيات ============ */
  .stats{
    display:flex;gap:18px;flex-wrap:wrap;justify-content:center;
    margin-top:60px;width:100%;max-width:820px;
  }
  .stat{
    flex:1 1 150px;padding:20px 14px;border-radius:16px;
    background:var(--card);border:1px solid var(--line);
    backdrop-filter:blur(8px);
    box-shadow:0 0 30px rgba(0,234,255,.07) inset;
  }
  .stat b{
    display:block;font-size:2rem;font-family:'Orbitron',sans-serif;
    color:var(--cyan);text-shadow:0 0 18px rgba(0,234,255,.75);
  }
  .stat small{color:var(--muted);font-size:.85rem}

  /* ============ الأقسام ============ */
  section{padding:95px 5vw;position:relative}
  .head{text-align:center;margin-bottom:56px}
  .head .tag{
    font-family:'Orbitron',sans-serif;font-size:.72rem;letter-spacing:3px;
    color:var(--magenta);text-shadow:0 0 12px rgba(255,31,214,.8);
  }
  .head h2{
    font-size:clamp(1.7rem,4.5vw,2.7rem);font-weight:900;margin-top:8px;
    color:#fff;text-shadow:0 0 22px rgba(0,234,255,.35);
  }
  .head h2 em{
    font-style:normal;
    background:linear-gradient(90deg,var(--cyan),var(--magenta));
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .head p{color:var(--muted);margin-top:10px;font-size:.95rem}
  .divider{
    width:90px;height:3px;margin:16px auto 0;border-radius:3px;
    background:linear-gradient(90deg,transparent,var(--cyan),var(--magenta),transparent);
    box-shadow:0 0 16px rgba(0,234,255,.7);
  }

  /* ============ كروت الخدمات ============ */
  .services{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:26px;max-width:1200px;margin:0 auto}
  .card{
    background:var(--card);border:1px solid var(--line);border-radius:20px;
    padding:34px 26px;position:relative;overflow:hidden;
    backdrop-filter:blur(10px);transition:.45s;
  }
  .card::before{
    content:'';position:absolute;top:0;right:0;width:100%;height:3px;
    background:linear-gradient(90deg,var(--cyan),var(--magenta));
    transform:scaleX(0);transform-origin:right;transition:.5s;
  }
  .card:hover::before{transform:scaleX(1)}
  .card:hover{
    transform:translateY(-10px);
    border-color:rgba(0,234,255,.55);
    box-shadow:0 18px 50px rgba(0,234,255,.18), 0 0 40px rgba(123,44,255,.18) inset;
  }
  .icon-box{
    width:64px;height:64px;border-radius:16px;display:grid;place-items:center;
    margin-bottom:20px;color:var(--cyan);
    border:1px solid rgba(0,234,255,.4);
    background:radial-gradient(circle at 30% 20%, rgba(0,234,255,.22), transparent 70%);
    box-shadow:0 0 24px rgba(0,234,255,.25);
  }
  .icon-box svg{width:32px;height:32px}
  .card h3{font-size:1.25rem;font-weight:900;color:#fff;margin-bottom:12px}
  .card p{color:var(--muted);font-size:.93rem;margin-bottom:18px}
  .card ul{list-style:none;display:flex;flex-direction:column;gap:9px}
  .card ul li{font-size:.88rem;color:#b9cbe2;display:flex;align-items:center;gap:8px}
  .card ul li::before{content:'▸';color:var(--magenta);text-shadow:0 0 10px var(--magenta)}

  /* ============ المميزات ============ */
  .features{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;max-width:1100px;margin:0 auto;
  }
  .feat{
    text-align:center;padding:28px 18px;border-radius:16px;
    background:rgba(10,13,24,.6);border:1px solid rgba(123,44,255,.28);
    transition:.4s;
  }
  .feat:hover{border-color:var(--magenta);box-shadow:0 0 30px rgba(255,31,214,.25);transform:translateY(-6px)}
  .feat b{display:block;font-size:1.6rem;margin-bottom:6px}
  .feat h4{color:#fff;font-size:1rem;margin-bottom:6px}
  .feat p{font-size:.84rem;color:var(--muted)}

  /* ============ المعرض ============ */
  .gallery{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:18px;max-width:1150px;margin:0 auto;
  }
  .work{
    height:200px;border-radius:16px;position:relative;overflow:hidden;
    border:1px solid var(--line);display:grid;place-items:center;
    font-weight:900;color:#fff;font-size:1.05rem;letter-spacing:1px;
    transition:.45s;cursor:pointer;
  }
  .work span{position:relative;z-index:2;text-shadow:0 0 14px rgba(0,0,0,.9)}
  .work::after{
    content:'';position:absolute;inset:0;opacity:.9;transition:.45s;
  }
  .work:hover{transform:scale(1.04);border-color:var(--cyan);box-shadow:0 0 34px rgba(0,234,255,.45)}
  .work:hover::after{opacity:1;filter:brightness(1.25)}
  .w1::after{background:linear-gradient(135deg,#0b1a3a,#00eaff55,#0b1a3a)}
  .w2::after{background:linear-gradient(135deg,#2a0b3a,#ff1fd655,#2a0b3a)}
  .w3::after{background:linear-gradient(135deg,#0b3a2a,#22ff8855,#0b3a2a)}
  .w4::after{background:linear-gradient(135deg,#3a2a0b,#ffb30055,#3a2a0b)}
  .w5::after{background:linear-gradient(135deg,#1a0b3a,#7b2cff55,#1a0b3a)}
  .w6::after{background:linear-gradient(135deg,#3a0b1a,#ff386055,#3a0b1a)}

  /* ============ الفورم ============ */
  .order-box{
    max-width:760px;margin:0 auto;padding:38px 30px;border-radius:22px;
    background:var(--card);border:1px solid var(--line);
    backdrop-filter:blur(10px);
    box-shadow:0 0 60px rgba(0,234,255,.10);
  }
  .field{margin-bottom:18px}
  .field label{display:block;font-size:.87rem;font-weight:700;color:var(--cyan);margin-bottom:8px}
  .field input,.field select,.field textarea{
    width:100%;padding:14px 16px;border-radius:12px;font-family:'Cairo',sans-serif;
    background:rgba(4,5,10,.75);border:1px solid rgba(0,234,255,.28);
    color:#fff;font-size:.95rem;outline:none;transition:.3s;
  }
  .field textarea{min-height:120px;resize:vertical}
  .field input:focus,.field select:focus,.field textarea:focus{
    border-color:var(--cyan);box-shadow:0 0 20px rgba(0,234,255,.35);
  }
  .field select option{background:#0a0d18;color:#fff}
  .order-box .btn{width:100%;margin-top:6px}
  .note{text-align:center;font-size:.8rem;color:var(--muted);margin-top:14px}

  /* ============ التواصل ============ */
  .contact-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:24px;max-width:900px;margin:0 auto;
  }
  .c-card{
    text-align:center;padding:36px 24px;border-radius:20px;
    background:var(--card);border:1px solid var(--line);
    backdrop-filter:blur(10px);transition:.4s;
  }
  .c-card:hover{transform:translateY(-8px)}
  .c-card .ico{
    width:70px;height:70px;margin:0 auto 18px;border-radius:50%;
    display:grid;place-items:center;
  }
  .c-card .ico svg{width:34px;height:34px}
  .c-card.wa .ico{background:radial-gradient(circle,rgba(37,211,102,.3),transparent 70%);box-shadow:0 0 28px rgba(37,211,102,.45);color:#25D366}
  .c-card.ig .ico{background:radial-gradient(circle,rgba(214,41,118,.3),transparent 70%);box-shadow:0 0 28px rgba(214,41,118,.45);color:#ff4fa3}
  .c-card h4{color:#fff;font-size:1.15rem;margin-bottom:8px}
  .c-card .val{
    font-family:'Orbitron',sans-serif;font-size:1.05rem;letter-spacing:1px;
    color:var(--cyan);text-shadow:0 0 14px rgba(0,234,255,.7);
    margin-bottom:20px;direction:ltr;
  }
  .c-card.ig .val{color:#ff4fa3;text-shadow:0 0 14px rgba(255,79,163,.7)}

  /* ============ الفوتر ============ */
  footer{
    border-top:1px solid var(--line);
    padding:48px 5vw 34px;text-align:center;
    background:linear-gradient(to top, rgba(10,13,24,.95), transparent);
  }
  footer .fname{
    font-size:1.4rem;font-weight:900;
    background:linear-gradient(90deg,var(--cyan),var(--magenta));
    -webkit-background-clip:text;background-clip:text;color:transparent;
    margin-bottom:8px;
  }
  footer p{color:var(--muted);font-size:.87rem}
  .f-links{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:24px 0 18px}
  .f-links a{
    display:inline-flex;align-items:center;gap:8px;
    padding:11px 22px;border-radius:50px;font-weight:700;font-size:.88rem;
    border:1px solid var(--line);transition:.35s;
  }
  .f-links a svg{width:18px;height:18px}
  .f-links a.wa{color:#25D366;border-color:rgba(37,211,102,.45)}
  .f-links a.wa:hover{background:rgba(37,211,102,.14);box-shadow:0 0 24px rgba(37,211,102,.5)}
  .f-links a.ig{color:#ff4fa3;border-color:rgba(255,79,163,.45)}
  .f-links a.ig:hover{background:rgba(255,79,163,.14);box-shadow:0 0 24px rgba(255,79,163,.5)}
  .copy{font-size:.78rem;color:#5f7391;border-top:1px solid rgba(255,255,255,.06);padding-top:20px;margin-top:10px}

  /* ============ أزرار عائمة ============ */
  .float-wa{
    position:fixed;bottom:22px;left:22px;z-index:1500;
    width:58px;height:58px;border-radius:50%;display:grid;place-items:center;
    background:linear-gradient(135deg,#25D366,#128C7E);
    box-shadow:0 0 26px rgba(37,211,102,.7);
    transition:.35s;
  }
  .float-wa svg{width:30px;height:30px;fill:#fff}
  .float-wa:hover{transform:scale(1.12) rotate(6deg)}
  .to-top{
    position:fixed;bottom:22px;right:22px;z-index:1500;
    width:50px;height:50px;border-radius:14px;display:grid;place-items:center;
    background:rgba(0,234,255,.12);border:1px solid var(--cyan);color:var(--cyan);
    cursor:pointer;opacity:0;visibility:hidden;transition:.4s;font-size:1.2rem;
    backdrop-filter:blur(8px);
  }
  .to-top.show{opacity:1;visibility:visible}
  .to-top:hover{background:rgba(0,234,255,.28);box-shadow:0 0 24px rgba(0,234,255,.7)}

  /* ============ ظهور العناصر ============ */
  .reveal{opacity:0;transform:translateY(45px);transition:.9s cubic-bezier(.2,.8,.2,1)}
  .reveal.show{opacity:1;transform:none}

  /* ============ الموبايل ============ */
  @media (max-width:880px){
    .burger{display:grid;place-items:center}
    nav ul{
      position:fixed;top:67px;right:0;left:0;
      flex-direction:column;gap:0;
      background:rgba(6,8,16,.98);
      border-bottom:1px solid var(--line);
      max-height:0;overflow:hidden;transition:.45s;
    }
    nav ul.open{max-height:460px;padding:14px 0}
    nav ul li{width:100%;text-align:center}
    nav ul li a{display:block;padding:14px;font-size:1rem}
    section{padding:70px 5vw}
    .hero{padding-top:115px}
    .stats{gap:12px}
    .stat{flex:1 1 44%}
    .order-box{padding:26px 18px}
    .glitch{letter-spacing:0}
    .profile-pic { width: 150px; height: 150px; }
  }
  @media (max-width:420px){
    .btn{padding:12px 22px;font-size:.88rem}
    .hero-btns{gap:10px}
    .profile-pic { width: 130px; height: 130px; }
  }
</style>
</head>
<body>

<!-- خلفيات -->
<div class="bg-layer"></div>
<div class="grid-floor"></div>
